# Copy to backend/.env (never commit .env). Backend-only secrets. Never paste them in chat.

# Which AI writes the summary: gemini or claude
AI_PROVIDER=gemini
# Google AI Studio key. Free tier: Google may use the content to improve its products,
# so use it only on your own repos.
GEMINI_API_KEY=
# Only needed when AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Used only when running the backend outside docker. In docker compose the app always
# uses its own Postgres container.
DATABASE_URL=postgresql+psycopg://pr_summary:local_dev_only@localhost:5432/pr_summary
