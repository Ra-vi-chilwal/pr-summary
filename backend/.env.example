# Copy to backend/.env and fill in. Never commit .env. Never paste these values in chat.
# docker compose reads this file for the API container.

# ---------------------------------------------------------------- AI
# Which AI writes the summary: gemini or claude
AI_PROVIDER=gemini
# Google AI Studio key. Free tier: Google may use the content to improve its products,
# so only use the free tier on your own repos.
GEMINI_API_KEY=
# Only needed when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
MONTHLY_SPEND_CAP_USD=10
REVIEWS_PER_REPO_PER_MONTH=50

# ---------------------------------------------------------------- App & sessions
# Where the browser opens the app. GitHub redirects back here.
APP_BASE_URL=http://localhost:5180
# Long random string; signs short-lived cookies. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
SESSION_DAYS=14

# ---------------------------------------------------------------- Logging
# DEBUG, INFO, WARNING or ERROR. Logs are JSON; secrets are redacted.
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------- GitHub App
# Create the app first (README: "Create the GitHub App"), then fill these in.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem GitHub gives you, on ONE line with \n where the line breaks were:
#   python -c "print(open('key.pem').read().replace('\n','\\n'))"
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Database
# Used only when running the backend outside docker. In docker compose the API always
# uses its own Postgres container. In production this is your Neon connection string.
DATABASE_URL=postgresql+psycopg://pr_summary:local_dev_only@localhost:5432/pr_summary
